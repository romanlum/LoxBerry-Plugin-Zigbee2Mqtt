[Unit]
Description=zigbee2mqtt wsproxy
After=network.target createtmpfs.service loxberry.service zigbee2mqtt.service
Requires=zigbee2mqtt.service

[Service]
Environment=PATH=/opt/zigbee2mqtt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=Z2M_WSPROXY_PORT=8882
Environment=Z2M_WSPROXY_TARGET=ws://127.0.0.1:8881/api
Environment=Z2M_WSPROXY_CERT_PATH=/opt/zigbee2mqtt/wsproxy/tls/cert.pem
Environment=Z2M_WSPROXY_KEY_PATH=/opt/zigbee2mqtt/wsproxy/tls/key.pem
ExecStart=node wsproxy.js
WorkingDirectory=/opt/zigbee2mqtt/wsproxy
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=30
User=loxberry

[Install]
WantedBy=multi-user.target
