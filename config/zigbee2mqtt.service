[Unit]
Description=zigbee2mqtt
After=network.target network.target createtmpfs.service loxberry.service

[Service]
Environment=PATH=/opt/zigbee2mqtt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=Z2M_ONBOARD_URL=http://127.0.0.1:8881
# systemd resolves ExecStart with its compiled-in search path, not with
# PATH above; env resolves npm with PATH: the vendored node first, else the
# system node (installs from plugin 2.x and older have no vendored node).
ExecStart=/usr/bin/env npm start
WorkingDirectory=/opt/zigbee2mqtt
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=30
User=loxberry

[Install]
WantedBy=multi-user.target
